      "m_name": "124",
      "m_stringValue": "                                      ███████████████████████████\r\n                                      ███████▀▀▀░░░░░░░▀▀▀███████\r\n                                      ████▀░░░░░░░░░░░░░░░░░▀████\r\n                                      ███│░░░░░░░░░░░░░░░░░░░│███\r\n                                      ██▌│░░░░░░░░░░░░░░░░░░░│▐██\r\n                                      ██░└┐░░░░░░░░░░░░░░░░░┌┘░██\r\n                                      ██░░└┐░░░░░░░░░░░░░░░┌┘░░██    \r\n                                      ██░░┌┘▄▄▄▄▄░░░░░▄▄▄▄▄└┐░░██\r\n                                      ██▌░│██████▌░░░▐██████│░▐██\r\n                                      ███░│▐███▀▀░░▄░░▀▀███▌│░███\r\n                                      ██▀─┘░░░░░░░▐█▌░░░░░░░└─▀██\r\n                                      ██▄░░░▄▄▄▓░░▀█▀░░▓▄▄▄░░░▄██\r\n                                      ████▄─┘██▌░░░░░░░▐██└─▄████            \r\n                                      █████░░▐█─┬┬┬┬┬┬┬─█▌░░█████\r\n                                      ████▌░░░▀┬┼┼┼┼┼┼┼┬▀░░░▐████\r\n                                      █████▄░░░└┴┴┴┴┴┴┴┘░░░▄█████\r\n                                      ███████▄░░░░░░░░░░░▄███████\r\n                                      ██████████▄▄▄▄▄▄▄██████████\r\n[HKEY_CURRENT_USER\\ANDROID\\REG VIP]\r\n\"ActiveWindowTracking\"=dword:00000000\r\n\"Beep\"=\"No\"\r\n\"DoubleClickHeight\"=\"4\"\r\n\"DoubleClickSpeed\"=\"550\"\r\n\"DoubleClickWidth\"=\"4\"\r\n\"ExtendedSounds\"=\"No\"\r\n\"MouseHoverHeight\"=\"4\"\r\n\"MouseHoverWidth\"=\"4\"\r\n\"MouseSensitivity\"=\"8\"\r\n\"MouseSpeed\"=\"0\"\r\n\"MouseThreshold1\"=\"0\"\r\n\"MouseThreshold2\"=\"0\"\r\n\"MouseTrails\"=\"0\"\r\n\"SmoothMouseXCurve\"=hex:00,00,00,00,00,00,00,00,15,6e,00,00,00,00,00,00,00,40,\\\r\n  01,00,00,00,00,00,29,dc,03,00,00,00,00,00,00,00,28,00,00,00,00,00\r\n\"SmoothMouseYCurve\"=hex:00,00,00,00,00,00,00,00,b8,5e,01,00,00,00,00,00,cd,4c,\\\r\n  05,00,00,00,00,00,cd,4c,18,00,00,00,00,00,00,00,38,0